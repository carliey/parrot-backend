PARROT_PROVIDER=hf_space
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=cnc9FDcyBlbzxv28zGEM
ELEVENLABS_MODEL_ID=eleven_v4
# Local laptop testing only: set PARROT_PROVIDER=ollama.
PARROT_GENERATION_SPACE=phaeeza/parrot-ai
PARROT_GENERATION_TIMEOUT_SECONDS=180
PARROT_MODEL_ID=hf.co/QuantFactory/N-ATLaS-GGUF:Q4_K_M
PARROT_OLLAMA_URL=http://127.0.0.1:11434
PARROT_DB=./parrot.sqlite3

# Copy this file to .env and replace the placeholder THERE, not in this example.
# Keep the token on the backend. Never use an EXPO_PUBLIC_ variable for it.
HF_TOKEN=hf_replace_with_your_token
PARROT_ASR_PROVIDER=hf_space
PARROT_ASR_SPACE=phaeeza/Hausa-tutor-conversation-voice-first
PARROT_ASR_TIMEOUT_SECONDS=90
# ffmpeg must be installed and available on PATH.
PARROT_FFMPEG=ffmpeg
# Laptop official Hausa ASR: install requirements-speech.txt, then set PARROT_ASR_PROVIDER=local.
# Experimental generic Whisper: install requirements-whisper.txt, then set PARROT_ASR_PROVIDER=whisper.
# PARROT_WHISPER_CHECKPOINT=/Users/your-name/.cache/whisper/base.pt
# The older NCAIR1/Hausa-ASR local path remains available with PARROT_ASR_PROVIDER=local.
