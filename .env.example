PARROT_PROVIDER=ollama
PARROT_MODEL_ID=hf.co/QuantFactory/N-ATLaS-GGUF:Q4_K_M
PARROT_OLLAMA_URL=http://127.0.0.1:11434
PARROT_DB=./parrot.sqlite3

# Copy this file to .env and replace the placeholder THERE, not in this example.
# Keep the token on the backend. Never use an EXPO_PUBLIC_ variable for it.
HF_TOKEN=hf_replace_with_your_token
PARROT_ASR_PROVIDER=hf_space
PARROT_ASR_SPACE=phaeeza/Hausa-tutor-conversation-voice-first
PARROT_ASR_TIMEOUT_SECONDS=90
# ffmpeg must be installed and available on PATH.
PARROT_FFMPEG=ffmpeg
# To run ASR locally instead: PARROT_ASR_PROVIDER=local
