  "lessons": [
    {
      "id": "greetings",
      "title": "Greetings",
      "description": "Practise a short greeting, one phrase at a time.",
      "scenario": "You play the elder greeting a younger person. The tutor responds as the younger person.",
      "objective": "Greet someone, ask about their day and wellbeing, then close warmly.",
      "color": "#DDE8C5",
      "icon": "✳",
      "opening": "You are the elder in this exercise. Start with “Sannu”.",
      "cultural_notes": [
        "In this lesson, “Ya kake?” / “Ya kike?” is used by an elder addressing a younger person. Do not use it to address an elder.",
        "Use “Ya kake?” for a male addressee and “Ya kike?” for a female addressee.",
        "The same afternoon and evening forms are taught here. The practice accepts morning, afternoon, or evening greetings."
      ],
      "vocabulary": [
        {
          "id": "g1",
          "hausa": "Sannu",
          "english": "Well done",
          "response": "Yauwa",
          "responseEnglish": "Acknowledgement",
          "note": ""
        },
        {
          "id": "g2",
          "hausa": "Yauwa",
          "english": "Response to “Sannu”",
          "response": "",
          "responseEnglish": "",
          "note": "Acknowledge the greeting."
        },
        {
          "id": "g3",
          "hausa": "Ina kwana? / Barka da safiya",
          "english": "Good morning",
          "response": "Lafiya / Lafiya lau",
          "responseEnglish": "The morning is fine",
          "note": ""
        },
        {
          "id": "g4",
          "hausa": "Ina yini? / An yini lafiya?",
          "english": "Good afternoon",
          "response": "Lafiya / Lafiya lau",
          "responseEnglish": "The afternoon is fine",
          "note": ""
        },
        {
          "id": "g5",
          "hausa": "Ina yini? / An yini lafiya?",
          "english": "Good evening",
          "response": "Lafiya / Lafiya lau",
          "responseEnglish": "The evening is fine",
          "note": ""
        },
        {
          "id": "g6",
          "hausa": "Ya kake? / Ya kike?",
          "english": "How are you?",
          "response": "Lafiya / Lafiya lau",
          "responseEnglish": "I am fine",
          "note": "Practise as an elder addressing a younger person, not as a child addressing an elder."
        },
        {
          "id": "g7",
          "hausa": "Lafiya / Lafiya lau",
          "english": "I am fine; the morning, afternoon, or evening is fine",
          "response": "",
          "responseEnglish": "",
          "note": ""
        },
        {
          "id": "g8",
          "hausa": "Madallah",
          "english": "Praise be to God",
          "response": "",
          "responseEnglish": "",
          "note": "Closes the supplied example greeting."
        }
      ],
      "steps": [
        {
          "id": "greet",
          "task": "greet someone",
          "hint": "Sannu",
          "english": "Well done",
          "accepted": ["Sannu"],
          "replies": ["Yauwa"],
          "matcher": "exact"
        },
