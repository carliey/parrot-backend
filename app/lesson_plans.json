    {
      "id": "introductions",
      "title": "Introductions",
      "description": "Say your name and ask about the other person.",
      "scenario": "Meet your practice partner, Musa. The tutor asks your name first.",
      "objective": "Say your name, ask “what about you?”, acknowledge the introduction, and say thanks.",
      "color": "#D8E5F0",
      "icon": "◎",
      "opening": "Ya sunanka?",
      "cultural_notes": [
        "This first exercise uses the supplied question “Ya sunanka?”. This is a practice role, not an assumption about the learner’s gender.",
        "Use “Kai fa?” for a male addressee and “Ke fa?” for a female addressee. Both forms are accepted in practice.",
        "Replace the name placeholder with your own name. Musa is the tutor’s example name."
      ],
      "vocabulary": [
        {
          "id": "i1",
          "hausa": "Ya sunanka?",
          "english": "What is your name?",
          "response": "Suna na …",
          "responseEnglish": "My name is …",
          "note": ""
        },
        {
          "id": "i2",
          "hausa": "Suna na …",
          "english": "My name is …",
          "response": "Sannu",
          "responseEnglish": "Well done",
          "note": "Replace … with your name. “Sunana …” is also accepted."
        },
        {
          "id": "i3",
          "hausa": "Kai fa? / Ke fa?",
          "english": "What about you?",
          "response": "Suna na Musa",
          "responseEnglish": "My name is Musa",
          "note": "Kai: male addressee. Ke: female addressee."
        },
        {
          "id": "i4",
          "hausa": "Sannu",
          "english": "Well done",
          "response": "Yauwa",
          "responseEnglish": "Acknowledgement",
          "note": ""
        },
        {
          "id": "i5",
          "hausa": "Na gode",
          "english": "Thank you",
          "response": "",
          "responseEnglish": "",
          "note": "“Nagode” is also accepted."
        }
      ],
      "steps": [
        {
          "id": "name",
          "task": "introduce yourself",
          "hint": "Suna na …",
          "english": "My name is …",
          "accepted": ["Suna na", "Sunana"],
          "replies": ["Sannu"],
          "matcher": "name"
        },
        {
          "id": "reciprocal",
          "task": "ask about the other person",
