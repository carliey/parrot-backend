    {
      "id": "buying-things",
      "title": "Buying Things",
      "description": "Point to an item, ask its price, and buy it.",
      "scenario": "You are the buyer. Point to an item at a small shop; in this exercise it costs ₦200.",
      "objective": "Greet the seller, ask the price, request the item, and say thanks.",
      "color": "#F7D7BF",
      "icon": "◈",
      "opening": "You are the buyer. Greet the seller with “Sannu”.",
      "cultural_notes": [
        "“Nawa ne wannan?” can refer to any item you point to.",
        "Either person may say “Na gode” at the end: the seller thanks the buyer for buying, and the buyer thanks the seller for providing the item.",
        "Price examples are ₦100, ₦200, and ₦500. This first exercise keeps the price fixed at ₦200."
      ],
      "vocabulary": [
        {
          "id": "b1",
          "hausa": "Sannu",
          "english": "Well done",
          "response": "Yauwa",
          "responseEnglish": "Acknowledgement",
          "note": ""
        },
        {
          "id": "b2",
          "hausa": "Nawa ne wannan?",
          "english": "How much is this?",
          "response": "₦200",
          "responseEnglish": "200 naira",
          "note": "Point to any item. “Nawane wannan” is also accepted."
        },
        {
          "id": "b3",
          "hausa": "₦100 / ₦200 / ₦500",
          "english": "Example prices",
          "response": "",
          "responseEnglish": "",
          "note": "The seller answers with a price. The practice item costs ₦200."
        },
        {
          "id": "b4",
          "hausa": "A ba ni",
          "english": "Give me",
          "response": "Na gode",
          "responseEnglish": "Thank you",
          "note": "“A bani” is also accepted. Point to the item you want."
        },
        {
          "id": "b5",
          "hausa": "Na gode",
          "english": "Thank you",
          "response": "Na gode",
          "responseEnglish": "Thank you",
          "note": "Either the buyer or the seller can say this at the end. “Nagode” is accepted."
        }
      ],
      "steps": [
        {
          "id": "greet",
          "task": "greet the seller",
          "hint": "Sannu",
          "english": "Well done",
          "accepted": ["Sannu"],
          "replies": ["Yauwa"],
          "matcher": "exact"
        },
        {
          "id": "price",
          "task": "ask its price",
          "hint": "Nawa ne wannan?",
          "english": "How much is this?",
          "accepted": ["Nawa ne wannan", "Nawane wannan"],
          "replies": ["₦200"],
          "matcher": "exact"
        },
        {
          "id": "request",
          "task": "request the item",
          "hint": "A ba ni",
          "english": "Give me",
          "accepted": ["A ba ni", "A bani"],
          "replies": ["Na gode"],
          "matcher": "exact"
        },
        {
          "id": "thanks",
          "task": "thank the seller",
          "hint": "Na gode",
          "english": "Thank you",
          "accepted": ["Na gode", "Nagode"],
          "replies": ["Na gode"],
          "matcher": "exact"
        }
      ],
      "mode": "guided"
    },
